# 실제 값은 .env 에 넣습니다. .env 는 .gitignore 처리되어 커밋되지 않습니다.
# 사용법: cp .env.example .env  (Windows: copy .env.example .env)

# --- 앱 ---
APP_ROLE=api                 # api | worker-agent | worker-ingest
DEBUG=false                  # 운영에서 true 면 기동 점검이 경고합니다

# 호스트 nginx 가 프록시할 로컬 포트 (docker-compose.deploy.yml).
# 127.0.0.1 에만 바인드되므로 외부에서 직접 접근되지 않습니다.
# 바꾸면 deploy/nginx-realestate.conf 의 proxy_pass 도 함께 바꿔야 합니다.
API_BIND_PORT=8013

# --- 지도 ---
KAKAO_REST_API_KEY=
KAKAO_JS_APP_KEY=

# --- 공공 데이터 ---
MOLIT_API_KEY=               # 국토교통부 실거래가 (공공데이터포털 서비스키)
DATA_GO_KR_API_KEY=          # 공공데이터포털 공통 키 (공시가격/건축물대장 등)
# NEIS_API_KEY: 교육부 NEIS 교육정보 개방 포털(open.neis.go.kr) 인증키.
#   **학원 데이터('학원가' 태그)에는 필수입니다.** 무키로도 응답은 오지만 행을 5건만
#   주고 pSize·pIndex 를 조용히 무시합니다(실측 2026-07-28) — 즉 전량 수집이 불가능
#   합니다. 수집기는 그 상태를 감지하면 파일을 쓰지 않고 멈춥니다.
#   학교 기본정보(schoolInfo)도 같은 제약을 받습니다. 비워 두면 두 수집이 멈출 뿐,
#   나머지 기능은 영향받지 않습니다.
NEIS_API_KEY=
# 정비사업(재건축) 수집에는 **인증키가 필요하지 않습니다** — 서울 열린데이터광장의
# 공개 CSV(OA-22856)를 https 로 받습니다(scripts/load_redevelopment.py).
# 예전에 있던 SEOUL_OPENAPI_KEY 칸은 삭제했습니다: 그 경로가 인증키를 평문 HTTP 의
# URL 경로에 실어 보내고 예외 메시지로 흘렸기 때문입니다(SR24-1). 쓰지 않는 비밀
# 칸을 남겨 두면 언젠가 누군가 채웁니다.

# --- AI 에이전트 ---
# ANTHROPIC_API_KEY: 추천 결과의 **요약 문장**을 Claude 가 쓰게 합니다.
#   비워 두어도 추천은 정상 동작합니다 — 순위·가격 근거·제외 사유는 규칙과 실거래
#   통계로 계산하므로 키 유무와 무관합니다. 다만 요약이 규칙 기반이라는 사실이
#   응답 notes 와 각 카드의 summary_basis 에 남습니다(api-spec §5.4).
#   ⚠️ 이 키가 붙으면 분석 근거가 **실제로 외부(api.anthropic.com)로 나갑니다.**
#      나가는 것은 규칙 계산 결과(한도·시세 밴드·입지 근거)뿐이고 보유현금·연소득
#      **원본은 구조적으로 실리지 않습니다**(security.md §6 · SR4-2).
#   비용 상한: 추천 1건당 요약 호출 최대 10회 · 출력 900토큰 · 입력 2만자.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- DB (PostgreSQL + PostGIS) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=realestate
POSTGRES_USER=
POSTGRES_PASSWORD=
# 서버측 쿼리 상한(ms). API·워커 커넥션에만 붙는다(수집 배치는 별도 엔진이라 영향 없음).
# ⚠️ 끄지 말 것(0). 범위 통계 쿼리 하나가 192m 짜리 db 컨테이너를 눕힐 수 있고,
#    클라이언트 타임아웃은 서버 쿼리를 멈추지 못한다. (SR24-4)
DB_STATEMENT_TIMEOUT_MS=10000

# --- 캐시 · 큐 ---
REDIS_URL=redis://redis:6379/0

# --- 앱 보안 ---
# JWT_SECRET: 32자 이상. 예) python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# FIELD_ENCRYPTION_KEY: 자산·소득 컬럼 암호화 키. **정확히 32바이트**여야 기동합니다.
#   예) python -c "import secrets,string;a=string.ascii_letters+string.digits;print(''.join(secrets.choice(a) for _ in range(32)))"
#   ⚠️ 이 키를 잃으면 저장된 자산 정보를 복호화할 수 없습니다. 별도 백업하세요.
FIELD_ENCRYPTION_KEY=

# COOKIE_SECURE: refresh 토큰 쿠키에 `Secure` 를 붙일지 여부.
#   refresh 토큰은 응답 본문이 아니라 httpOnly 쿠키로만 오갑니다(security.md §2.1).
#   브라우저는 `Secure` 쿠키를 http 응답에서 저장하지 않으므로, http://localhost 로
#   개발할 때만 false 로 내립니다. **운영에서는 DEBUG=false 인 한 무시되고 항상 Secure 입니다.**
COOKIE_SECURE=true

# --- Argon2id 비밀번호 해시 (보통은 건드릴 필요 없습니다) ---
# 기본값은 OWASP 권장 하한입니다. **이 아래로 내리면 기동이 막힙니다.**
# 메모리가 부족하면 파라미터가 아니라 ARGON2_CONCURRENCY 를 줄이세요 —
# 파라미터를 깎으면 비밀번호 크래킹 난이도가 그대로 내려갑니다.
ARGON2_MEMORY_KIB=19456      # 19MiB (하한). 해시 1건이 이만큼 씁니다
ARGON2_TIME_COST=2           # 하한
ARGON2_PARALLELISM=1         # 하한
ARGON2_CONCURRENCY=4         # 동시 해시 수. 최대 메모리 = 이 값 × MEMORY_KIB
ARGON2_WAIT_TIMEOUT_SEC=2.0  # 슬롯 대기 한도. 넘으면 인증만 503

# --- 도메인 설정 ---
# 세율·대출한도 설정 파일. status: verified 가 아니면 계산 API 가 503 을 반환합니다.
TAX_RULES_PATH=./config/tax_rules.yaml

# --- 배포 ---
DEPLOY_HOST=                 # 서버 IP (deploy-target.local.md 참조)
DEPLOY_USER=deploy           # root 직접 접속 금지 (security.md §4.1)
