# 실제 값은 .env 에 넣습니다. .env 는 .gitignore 처리되어 커밋되지 않습니다.
# 사용법: cp .env.example .env  (Windows: copy .env.example .env)

# --- 지도 ---
KAKAO_REST_API_KEY=
KAKAO_JS_APP_KEY=

# --- 공공 데이터 ---
MOLIT_API_KEY=            # 국토교통부 실거래가 (공공데이터포털 서비스키)
DATA_GO_KR_API_KEY=       # 공공데이터포털 공통 키 (공시가격/건축물대장 등)

# --- AI 에이전트 ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- DB (PostgreSQL + PostGIS) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=realestate
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- 앱 보안 ---
JWT_SECRET=               # 로그인 토큰 서명 키 (충분히 긴 랜덤 문자열)
FIELD_ENCRYPTION_KEY=     # 자산·소득·대출 등 민감 컬럼 암호화 키

# --- 배포 ---
DEPLOY_HOST=              # 서버 IP (deploy-target.local.md 참조)
DEPLOY_USER=deploy        # root 직접 접속 금지
