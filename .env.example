# 실제 값은 .env 에 넣습니다. .env 는 .gitignore 처리되어 커밋되지 않습니다.
# 사용법: cp .env.example .env  (Windows: copy .env.example .env)

# --- 앱 ---
APP_ROLE=api                 # api | worker-agent | worker-ingest
DEBUG=false                  # 운영에서 true 면 기동 점검이 경고합니다

# 호스트 nginx 가 프록시할 로컬 포트 (docker-compose.deploy.yml).
# 127.0.0.1 에만 바인드되므로 외부에서 직접 접근되지 않습니다.
# 바꾸면 deploy/nginx-realestate.conf 의 proxy_pass 도 함께 바꿔야 합니다.
API_BIND_PORT=8013

# --- 지도 ---
KAKAO_REST_API_KEY=
KAKAO_JS_APP_KEY=

# --- 공공 데이터 ---
MOLIT_API_KEY=               # 국토교통부 실거래가 (공공데이터포털 서비스키)
DATA_GO_KR_API_KEY=          # 공공데이터포털 공통 키 (공시가격/건축물대장 등)

# --- AI 에이전트 ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- DB (PostgreSQL + PostGIS) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=realestate
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- 캐시 · 큐 ---
REDIS_URL=redis://redis:6379/0

# --- 앱 보안 ---
# JWT_SECRET: 32자 이상. 예) python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# FIELD_ENCRYPTION_KEY: 자산·소득 컬럼 암호화 키. **정확히 32바이트**여야 기동합니다.
#   예) python -c "import secrets,string;a=string.ascii_letters+string.digits;print(''.join(secrets.choice(a) for _ in range(32)))"
#   ⚠️ 이 키를 잃으면 저장된 자산 정보를 복호화할 수 없습니다. 별도 백업하세요.
FIELD_ENCRYPTION_KEY=

# --- Argon2id 비밀번호 해시 (보통은 건드릴 필요 없습니다) ---
# 기본값은 OWASP 권장 하한입니다. **이 아래로 내리면 기동이 막힙니다.**
# 메모리가 부족하면 파라미터가 아니라 ARGON2_CONCURRENCY 를 줄이세요 —
# 파라미터를 깎으면 비밀번호 크래킹 난이도가 그대로 내려갑니다.
ARGON2_MEMORY_KIB=19456      # 19MiB (하한). 해시 1건이 이만큼 씁니다
ARGON2_TIME_COST=2           # 하한
ARGON2_PARALLELISM=1         # 하한
ARGON2_CONCURRENCY=4         # 동시 해시 수. 최대 메모리 = 이 값 × MEMORY_KIB
ARGON2_WAIT_TIMEOUT_SEC=2.0  # 슬롯 대기 한도. 넘으면 인증만 503

# --- 도메인 설정 ---
# 세율·대출한도 설정 파일. status: verified 가 아니면 계산 API 가 503 을 반환합니다.
TAX_RULES_PATH=./config/tax_rules.yaml

# --- 배포 ---
DEPLOY_HOST=                 # 서버 IP (deploy-target.local.md 참조)
DEPLOY_USER=deploy           # root 직접 접속 금지 (security.md §4.1)
